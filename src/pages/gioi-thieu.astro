---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Picture from '../components/Picture.astro';
import CtaBand from '../components/CtaBand.astro';
import site from '../data/site.json';
const stats = site.stats.filter((s) => s.value);
const values = [
  { t: 'Nặn tay trước, đúc sau', d: 'Máy móc giúp làm khuôn và đúc nhanh hơn, nhưng hình khối vẫn do nghệ nhân nặn bằng tay trên đất sét. Đó là chỗ một tác phẩm có hồn hay không.' },
  { t: 'Làm cho đúng chỗ đặt', d: 'Một bức phù điêu nhìn từ sảnh cao sáu mét khác với bức treo trên sofa. Xưởng hỏi kỹ khoảng cách nhìn, hướng sáng, màu tường trước khi phác thảo.' },
  { t: 'Bạn duyệt, rồi mới làm tiếp', d: 'Phác thảo, mẫu đất sét, mẫu màu: mỗi bước đều chờ bạn đồng ý. Không có bất ngờ khi tác phẩm đến công trình.' },
];
---
<Base title="Về xưởng" description="Điêu khắc Trần Sâm là xưởng điêu khắc và tạo hình theo yêu cầu: phù điêu, tượng, mô hình, linh vật. Nặn mẫu đất sét để khách duyệt trước khi đúc.">
  <PageHead title="Một xưởng làm bằng tay" lede="Điêu khắc Trần Sâm nhận làm phù điêu, tượng và mô hình theo yêu cầu. Từ một tấm ảnh mẫu hay một bức tường trống, xưởng đưa ý tưởng thành khối." crumbs={[{ href: '/gioi-thieu/', label: 'Về xưởng' }]} />

  <section class="wrap grid12 hero-img">
    <div class="a"><Picture src="phu-dieu-decor-11" alt="Nghệ nhân ngồi trước mảng phù điêu hoa văn bằng đất sét trong xưởng" ratio="4 / 3" sizes="(max-width: 900px) 100vw, 60vw" loading="eager" /></div>
    <div class="b"><Picture class="arch" src="phu-dieu-decor-20" alt="Cặp tượng cột người trắng đứng cạnh thợ trong xưởng" ratio="3 / 4" sizes="(max-width: 900px) 50vw, 30vw" /></div>
  </section>

  <section class="wrap grid12 story">
    <h2 class="h">Câu chuyện của xưởng</h2>
    <div class="prose txt">
      <p>[CẦN ĐIỀN] Đoạn này dành cho câu chuyện thật của xưởng: ai là người sáng lập, bắt đầu từ năm nào, ở đâu, vì sao chọn nghề điêu khắc, những công trình đáng nhớ.</p>
      <p>Hiện nay xưởng làm mười dòng tác phẩm, từ phù điêu trang trí, tượng thờ, tượng chân dung, đến linh vật cho nhà máy, mô hình phát sáng cho cửa hàng và đồ nội thất composite. Khách hàng gồm gia đình, nhà chùa, doanh nghiệp, đơn vị thiết kế trưng bày và agency sự kiện.</p>
    </div>
    {stats.length > 0 && (
      <dl class="stats">{stats.map((s) => <div><dd>{s.value}</dd><dt>{s.label}</dt></div>)}</dl>
    )}
  </section>

  <section class="on-cream values">
    <div class="wrap">
      <h2>Ba điều xưởng giữ</h2>
      <ul>{values.map((v) => <li><h3>{v.t}</h3><p>{v.d}</p></li>)}</ul>
    </div>
  </section>

  <section class="wrap strip" aria-label="Hình ảnh xưởng">
    <Picture src="phat-giao-16" alt="Khuôn phù điêu Phật đứng xếp trong sân xưởng" ratio="1 / 1" sizes="25vw" />
    <Picture src="phu-dieu-decor-16" alt="Phù điêu nhiều nhân vật bằng đất sét đang nặn" ratio="1 / 1" sizes="25vw" />
    <Picture src="mo-hinh-do-an-03" alt="Thợ đứng cạnh mô hình bánh mì xúc xích cao ngang người" ratio="1 / 1" sizes="25vw" />
    <Picture src="bao-tang-13" alt="Thợ hoàn thiện cụm tượng trong nhà trưng bày" ratio="1 / 1" sizes="25vw" />
  </section>

  <CtaBand />
</Base>
<style>
  .hero-img { align-items: end; row-gap: 1rem; }
  .a { grid-column: 1 / span 8; }
  .b { grid-column: 9 / span 4; }
  .story { padding-block: var(--section); row-gap: 2rem; }
  .h { grid-column: 1 / span 4; font-size: var(--step-3); }
  .txt { grid-column: 6 / span 7; }
  .stats { grid-column: 6 / span 7; display: flex; flex-wrap: wrap; gap: 2rem 3rem; margin: 1rem 0 0; }
  .stats dd { margin: 0; font-family: var(--font-display); font-variation-settings: 'wdth' 70; font-size: var(--step-4); line-height: 1; }
  .stats dt { font-size: var(--step--1); color: var(--fg-soft); margin-top: 0.4rem; }
  .values { padding-block: var(--section); }
  .values ul { list-style: none; margin: 3rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.5rem var(--gutter); }
  .values li { border-top: 1px solid var(--rule); padding-top: 1.25rem; }
  .values h3 { margin-bottom: 0.75rem; }
  .values p { color: var(--fg-soft); }
  .strip { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.5rem; padding-block: var(--section); }
  @media (max-width: 900px) { .a, .b, .h, .txt, .stats { grid-column: 1 / -1; } .values ul { grid-template-columns: 1fr; } .strip { grid-template-columns: repeat(2, 1fr); } }
</style>
