---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Icon from '../components/Icon.astro';
import MapCard from '../components/MapCard.astro';
import site from '../data/site.json';
import { phones, filled } from '../lib/contact';
const zalo = site.zalo ? `https://zalo.me/${site.zalo.replace(/\D/g, '')}` : '';
---
<Base title="Liên hệ và báo giá" description="Gửi ý tưởng, ảnh không gian và kích thước để nhận phác thảo và báo giá phù điêu, tượng, mô hình từ xưởng Điêu khắc Trần Sâm.">
  <PageHead title="Nhận phác thảo và báo giá" lede="Điền những gì bạn biết, phần còn lại xưởng sẽ hỏi khi gọi lại. Không mất phí tư vấn và phác thảo ban đầu." crumbs={[{ href: '/lien-he/', label: 'Liên hệ' }]} />
  <section class="wrap grid12 body">
    <div class="form"><QuoteForm /></div>
    <aside class="side">
      <h2>Liên hệ trực tiếp</h2>
      <div class="company"><img src="/brand/s-decor-480.webp" srcset="/brand/s-decor-480.webp 480w, /brand/s-decor-960.webp 960w" sizes="9rem" width="480" height="434" alt="Logo S-Decor" loading="lazy" /><p>Đơn vị chủ quản<strong>{site.company}</strong></p></div>
      <ul class="ways">
        <li><Icon name="phone" /><div><span class="k">Điện thoại</span>{phones.length ? phones.map((p) => <a href={`tel:${p.href}`}>{p.label}</a>) : <span>{site.phone}</span>}</div></li>
        {zalo && <li><Icon name="chat" /><div><span class="k">Zalo</span><a href={zalo} target="_blank" rel="noopener">Nhắn tin cho xưởng</a></div></li>}
        <li><Icon name="mail" /><div><span class="k">Email</span>{filled(site.email) ? <a href={`mailto:${site.email}`}>{site.email}</a> : <span>{site.email}</span>}</div></li>
        <li><Icon name="pin" /><div><span class="k">Xưởng</span><span>{site.address}</span></div></li>
        <li><Icon name="clock" /><div><span class="k">Giờ làm việc</span><span>{site.hours}</span></div></li>
      </ul>
      <p class="visit">Muốn xem mẫu tận nơi? Hẹn trước để nghệ nhân có mặt và chuẩn bị đèn soi mẫu cho bạn.</p>
      <MapCard class="map" />
    </aside>
  </section>
</Base>
<style>
  .body { padding-bottom: var(--section); row-gap: 3rem; }
  .form { grid-column: 1 / span 7; }
  .side { grid-column: 9 / span 4; }
  .side h2 { font-size: var(--step-3); margin-bottom: 1.5rem; }
  .ways { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .ways li { display: flex; gap: 0.9rem; padding: 1rem 0; border-bottom: 1px solid var(--rule); }
  .ways :global(.icon) { color: var(--jade-600); margin-top: 0.15rem; }
  .ways div { display: flex; flex-direction: column; }
  .k { font-size: var(--step--1); color: var(--fg-soft); }
  .visit { margin-top: 1.5rem; color: var(--fg-soft); }
  .side :global(.map) { margin-top: 2.5rem; }
  .company { display: flex; align-items: center; gap: 1rem; padding: 1rem 0 1.25rem; }
  .company img { width: 6.5rem; height: auto; flex: none; }
  .company p { margin: 0; font-size: var(--step--1); color: var(--fg-soft); display: flex; flex-direction: column; gap: 0.2rem; }
  .company strong { color: var(--ink); font-weight: 600; font-size: 0.95rem; letter-spacing: 0.02em; line-height: 1.35; }
  .ways div a + a { margin-top: 0.15rem; }
  @media (max-width: 900px) { .form, .side { grid-column: 1 / -1; } }
</style>
