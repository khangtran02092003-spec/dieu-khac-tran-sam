---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import WorkCard from '../../components/WorkCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { categories } from '../../data/categories';

const works = (await getCollection('tac-pham')).sort((a, b) => a.data.order - b.data.order);
const used = categories.filter((c) => works.some((w) => w.data.category === c.slug));
const ratios = ['4 / 5', '1 / 1', '3 / 4', '4 / 5', '4 / 3', '3 / 4'];
---
<Base title="Tác phẩm" description={`${works.length} tác phẩm phù điêu, tượng, mô hình do xưởng Điêu khắc Trần Sâm thực hiện, chia theo ${used.length} dòng.`}>
  <PageHead
    title="Tác phẩm của xưởng"
    lede={`${works.length} tác phẩm, từ mẫu đất sét trong xưởng đến khi lắp đặt tại công trình. Chọn một dòng để xem riêng.`}
    crumbs={[{ href: '/tac-pham/', label: 'Tác phẩm' }]}
  />

  <section class="wrap" aria-label="Danh sách tác phẩm">
    <!-- Thanh lọc dạng slider: một hàng trượt ngang, dính đầu trang khi cuộn -->
    <div class="fbar" data-fbar>
      <button type="button" class="arrow prev" data-scroll="-1" tabindex="-1" aria-hidden="true" hidden><Icon name="prev" /></button>
      <div class="filters" role="group" aria-label="Lọc theo dòng tác phẩm" data-filters>
        <button type="button" aria-pressed="true" data-f="">Tất cả <span>{works.length}</span></button>
        {used.map((c) => (
          <button type="button" aria-pressed="false" data-f={c.slug}>{c.name} <span>{works.filter((w) => w.data.category === c.slug).length}</span></button>
        ))}
      </div>
      <button type="button" class="arrow next" data-scroll="1" tabindex="-1" aria-hidden="true" hidden><Icon name="next" /></button>
    </div>
    <p class="sr-only" aria-live="polite" data-status></p>

    <ul class="grid" data-grid>
      {works.map((w, i) => (
        <li data-cat={w.data.category}><WorkCard work={w} ratio={ratios[i % ratios.length]} /></li>
      ))}
    </ul>
    <noscript><p>Xem theo dòng: {used.map((c) => <a href={`/tac-pham/${c.slug}/`}>{c.name}</a>)}</p></noscript>
  </section>

  <div class="spacer"></div>
  <CtaBand />
</Base>

<style>
  .fbar { position: sticky; top: 4.5rem; z-index: 5; display: flex; align-items: center; margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.5rem); padding-block: 0.6rem; background: rgba(251, 250, 246, 0.95); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border-bottom: 1px solid var(--rule); }
  .filters { display: flex; flex-wrap: nowrap; gap: 0.4rem; overflow-x: auto; scroll-behavior: smooth; scrollbar-width: none; flex: 1; min-width: 0;
    /* mờ dần hai mép khi còn mục bị khuất */
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 var(--fl, 0px), #000 calc(100% - var(--fr, 0px)), transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, #000 var(--fl, 0px), #000 calc(100% - var(--fr, 0px)), transparent 100%); }
  .filters::-webkit-scrollbar { display: none; }
  .fbar.can-l .filters { --fl: 3rem; }
  .fbar.can-r .filters { --fr: 3rem; }
  .filters button { flex: none; white-space: nowrap; min-height: 2.5rem; padding: 0.4rem 0.9rem; border: 1px solid #b9b09c; background: var(--plaster); cursor: pointer; font-size: 0.9rem; transition: background-color 150ms, color 150ms, border-color 150ms; }
  .arrow { flex: none; width: 2.5rem; height: 2.5rem; display: grid; place-items: center; border: 1px solid var(--rule); background: var(--plaster); cursor: pointer; transition: background-color 150ms; }
  .arrow:hover { background: var(--limestone); }
  .arrow :global(svg) { width: 1.1rem; height: 1.1rem; }
  .prev { margin-right: 0.5rem; }
  .next { margin-left: 0.5rem; }
  .filters button span { color: var(--fg-soft); font-size: 0.85em; margin-left: 0.2rem; }
  .filters button:hover { border-color: var(--ink); }
  .filters button[aria-pressed='true'] { background: var(--moss-800); color: var(--plaster); border-color: var(--moss-800); }
  .filters button[aria-pressed='true'] span { color: var(--verdigris-300); }
  .grid { list-style: none; margin: 0; padding: 0; columns: 3 18rem; column-gap: var(--gutter); }
  .grid li { break-inside: avoid; margin-bottom: clamp(2rem, 1.5rem + 1.5vw, 3rem); }
  .spacer { height: var(--section); }
  /* Điện thoại: vuốt ngang, bỏ mũi tên, tràn sát mép màn hình */
  @media (max-width: 720px) { .fbar { margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); } .arrow { display: none !important; } }
</style>

<script>
  const wrap = document.querySelector<HTMLElement>('[data-filters]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-grid] > li')];
  const status = document.querySelector<HTMLElement>('[data-status]');
  const apply = (f: string) => {
    wrap?.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.f === f)));
    let n = 0;
    items.forEach((li) => { const on = !f || li.dataset.cat === f; li.hidden = !on; if (on) n++; });
    if (status) status.textContent = `Đang hiển thị ${n} tác phẩm`;
    history.replaceState(null, '', f ? `#${f}` : location.pathname);
  };
  wrap?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button');
    if (!b) return;
    apply(b.dataset.f ?? '');
    b.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
    // đưa khách về đầu lưới tác phẩm nếu đang cuộn xa phía dưới
    const grid = document.querySelector<HTMLElement>('[data-grid]');
    const bar = document.querySelector<HTMLElement>('[data-fbar]');
    if (grid && bar && grid.getBoundingClientRect().top < 0) {
      scrollTo({ top: grid.getBoundingClientRect().top + scrollY - bar.offsetHeight - 90, behavior: 'smooth' });
    }
  });

  // Mũi tên trái/phải và mép mờ: chỉ hiện khi còn mục bị khuất phía đó
  const bar = document.querySelector<HTMLElement>('[data-fbar]');
  const prev = bar?.querySelector<HTMLButtonElement>('.prev');
  const next = bar?.querySelector<HTMLButtonElement>('.next');
  const update = () => {
    if (!wrap || !bar) return;
    const l = wrap.scrollLeft > 4;
    const r = wrap.scrollLeft + wrap.clientWidth < wrap.scrollWidth - 4;
    bar.classList.toggle('can-l', l);
    bar.classList.toggle('can-r', r);
    if (prev) prev.hidden = !l;
    if (next) next.hidden = !r;
  };
  bar?.querySelectorAll<HTMLButtonElement>('[data-scroll]').forEach((a) =>
    a.addEventListener('click', () => wrap?.scrollBy({ left: Number(a.dataset.scroll) * wrap.clientWidth * 0.7, behavior: 'smooth' }))
  );
  wrap?.addEventListener('scroll', update, { passive: true });
  addEventListener('resize', update);
  update();
  const h = location.hash.slice(1);
  const hb = h ? wrap?.querySelector<HTMLElement>(`[data-f="${CSS.escape(h)}"]`) : null;
  if (hb) { apply(h); hb.scrollIntoView({ inline: 'center', block: 'nearest' }); update(); }
</script>
