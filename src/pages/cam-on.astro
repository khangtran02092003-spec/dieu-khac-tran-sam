---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
---
<Base title="Đã gửi yêu cầu" noindex>
  <section class="wrap done">
    <h1>Xưởng đã nhận yêu cầu của bạn</h1>
    <p class="lede">Nghệ nhân sẽ gọi lại trong giờ làm việc ({site.hours.toLowerCase()}) để hỏi thêm và hẹn gửi phác thảo.</p>
    <p>Trong lúc chờ, bạn có thể xem thêm tác phẩm cùng dòng hoặc đọc về quy trình làm việc.</p>
    <div class="btns">
      <a class="btn btn-primary" href="/tac-pham/">Xem tác phẩm</a>
      <a class="btn btn-ghost" href="/quy-trinh/">Quy trình làm việc</a>
    </div>
  </section>
</Base>
<style>
  .done { padding-block: clamp(5rem, 4rem + 6vw, 10rem); max-width: 56rem; }
  h1 { font-size: var(--step-4); margin-bottom: 1.5rem; }
  .lede { max-width: 48ch; margin-bottom: 1rem; }
  .btns { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
</style>
