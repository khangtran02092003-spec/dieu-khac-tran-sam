---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Picture from '../components/Picture.astro';
import CtaBand from '../components/CtaBand.astro';
import { process } from '../data/categories';
const extra = [
  'Bạn chỉ cần ảnh chụp không gian, kích thước ước lượng và vài ảnh mẫu bạn thích. Chưa có ý tưởng rõ cũng được.',
  'Bản phác thảo được chỉnh đến khi bố cục, tỷ lệ và đề tài đúng ý. Báo giá chính thức đi kèm bản phác thảo đã chốt.',
  'Bạn đến xưởng xem trực tiếp, hoặc xem ảnh và video dưới nhiều góc đèn qua Zalo. Xưởng chỉ đúc khi bạn đồng ý.',
  'Tác phẩm lớn được chia mảng để vận chuyển, có khung thép và điểm neo tính sẵn cho vị trí lắp.',
  'Bạn duyệt mẫu màu trên tấm thử trước khi xưởng sơn toàn bộ tác phẩm.',
  'Đội lắp đặt của xưởng xử lý mối ghép, vệ sinh và hướng dẫn cách bảo quản khi bàn giao.',
];
---
<Base title="Quy trình làm việc" description="Sáu bước làm một tác phẩm tại xưởng Điêu khắc Trần Sâm: nghe ý tưởng, phác thảo, nặn mẫu đất sét, làm khuôn và đúc, hoàn thiện bề mặt, vận chuyển và lắp đặt.">
  <PageHead title="Quy trình làm việc" lede="Mỗi tác phẩm đi qua sáu bước. Ở bước nào bạn cũng được xem và góp ý trước khi xưởng làm bước tiếp theo." crumbs={[{ href: '/quy-trinh/', label: 'Quy trình' }]} />
  <ol class="wrap steps">
    {process.map((s, i) => (
      <li class="step">
        <div class="n engraved" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
        <div class="t">
          <h2>{s.title}</h2>
          <p class="lede">{s.text}</p>
          <p>{extra[i]}</p>
        </div>
        <Picture src={s.image} alt="" ratio="4 / 3" sizes="(max-width: 860px) 100vw, 40vw" class="img" />
      </li>
    ))}
  </ol>
  <CtaBand title="Sẵn sàng cho bước một?" text="Gửi ảnh không gian và ý tưởng. Xưởng gọi lại trong giờ làm việc." />
</Base>
<style>
  .steps { list-style: none; margin: 0 auto; padding-bottom: var(--section); }
  .step { display: grid; grid-template-columns: 6rem minmax(0, 5fr) minmax(0, 5fr); gap: 1.5rem var(--gutter); padding-block: clamp(2.5rem, 2rem + 2vw, 4rem); border-top: 1px solid var(--rule); align-items: start; }
  .n { font-family: var(--font-display); font-variation-settings: 'wdth' 62.5; font-weight: 600; font-size: clamp(3.5rem, 2.5rem + 3vw, 5.5rem); line-height: 0.9; }
  h2 { font-size: var(--step-3); margin-bottom: 1rem; }
  .t p:not(.lede) { color: var(--fg-soft); max-width: 52ch; }
  .lede { margin-bottom: 1rem; }
  @media (max-width: 860px) { .step { grid-template-columns: 1fr; } }
</style>
