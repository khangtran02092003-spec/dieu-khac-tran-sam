---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Picture from '../components/Picture.astro';
import CtaBand from '../components/CtaBand.astro';
import Motto from '../components/Motto.astro';
import { process, processTitle, processIntro } from '../data/categories';
---
<Base title="Quy trình sản xuất" description="Chín công đoạn sản xuất sản phẩm nhựa composite tại Điêu khắc Trần Sâm: tư vấn, thiết kế 2D/3D, tạo mẫu in 3D hoặc CNC, khuôn thạch cao, đúc composite, ráp nối, hoàn thiện bề mặt, sơn vẽ, kiểm tra và bàn giao.">
  <PageHead title={processTitle} lede={processIntro} crumbs={[{ href: '/quy-trinh/', label: 'Quy trình' }]} />
  <ol class="wrap steps">
    {process.map((s, i) => (
      <li class="step">
        <div class="n engraved" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
        <div class="t">
          <h2><span class="sr-only">Bước {i + 1}: </span>{s.title}</h2>
          <p class="lede">{s.text}</p>
        </div>
        <Picture src={s.image} alt={s.alt} ratio="4 / 3" sizes="(max-width: 860px) 100vw, 40vw" class="img" />
      </li>
    ))}
  </ol>
  <section class="wrap outro" aria-label="Cam kết"><Motto /></section>
  <CtaBand title="Sẵn sàng cho bước một?" text="Gửi ảnh không gian và ý tưởng. Xưởng gọi lại trong giờ làm việc." />
</Base>
<style>
  .steps { list-style: none; margin: 0 auto; padding-bottom: var(--section); }
  .step { display: grid; grid-template-columns: 6rem minmax(0, 5fr) minmax(0, 5fr); gap: 1.5rem var(--gutter); padding-block: clamp(2.5rem, 2rem + 2vw, 4rem); border-top: 1px solid var(--rule); align-items: start; }
  .n { font-family: var(--font-display); font-variation-settings: 'wdth' 62.5; font-weight: 600; font-size: clamp(3.5rem, 2.5rem + 3vw, 5.5rem); line-height: 0.9; }
  h2 { font-size: var(--step-3); margin-bottom: 1rem; }
  .t p:not(.lede) { color: var(--fg-soft); max-width: 52ch; }
  .lede { margin-bottom: 1rem; color: var(--fg-soft); max-width: 56ch; }
  .outro { padding-bottom: var(--section); }
  .steps { padding-bottom: clamp(3rem, 2rem + 3vw, 5rem); }
  @media (max-width: 860px) { .step { grid-template-columns: 1fr; } }
</style>
