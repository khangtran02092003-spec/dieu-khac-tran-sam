---
// Logo: biểu tượng S-Decor (chữ S xanh, tượng vàng, vòng cung) đặt trong một huy hiệu tròn màu thạch cao,
// để giữ đúng màu gốc trên cả nền tối (header đè ảnh, footer) lẫn nền sáng.
interface Props { class?: string; size?: 'md' | 'lg' }
const { class: cls, size = 'md' } = Astro.props;
---
<span class:list={['logo', `is-${size}`, cls]}>
  <span class="seal" aria-hidden="true">
    <img src="/brand/emblem-160.webp" srcset="/brand/emblem-160.webp 160w, /brand/emblem-320.webp 320w" sizes="4rem" width="160" height="136" alt="" decoding="async" />
  </span>
  <span class="word"><span class="a">Điêu khắc</span><span class="b">Trần <em>Sâm</em></span></span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.8rem; line-height: 1; }
  /* huy hiệu: nền thạch cao, viền vàng mảnh, bóng đổ lệch như ánh đèn xiên */
  .seal { --s: 3.1rem; position: relative; flex: none; width: var(--s); height: var(--s); border-radius: 50%; background: radial-gradient(circle at 35% 30%, #fffdf7, var(--plaster) 55%, #ece4d1); box-shadow: 0 0 0 1px rgba(201, 150, 40, 0.75), 0 0 0 3px rgba(251, 250, 246, 0.12), 2px 3px 8px rgba(0, 0, 0, 0.28); display: grid; place-items: center; }
  .seal img { width: 74%; height: auto; display: block; transform: translateY(-2%); }
  .word { display: flex; flex-direction: column; gap: 0.2rem; }
  .a { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.78; }
  .b { font-family: var(--font-display); font-variation-settings: 'wdth' 75; font-size: 1.5rem; font-weight: 500; letter-spacing: -0.005em; }
  .b em { font-style: normal; color: var(--gold, #c9962a); }
  .is-lg .seal { --s: 4.25rem; }
  .is-lg .b { font-size: 1.85rem; }
</style>
