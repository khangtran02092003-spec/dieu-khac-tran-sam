---
// Dấu hiệu: một ô vòm (như khám phù điêu) có viền trong lõm vào, chứa chữ lồng TS đắp nổi.
// Bóng đổ lệch về phải-dưới gợi ánh đèn xiên chiếu từ trên-trái — cùng ý tưởng với hero.
interface Props { class?: string; mono?: boolean }
const { class: cls, mono = false } = Astro.props;
---
<span class:list={['logo', cls]}>
  <svg viewBox="0 0 40 48" aria-hidden="true" class="mark">
    <!-- vòm ngoài -->
    <path d="M2 46V20a18 18 0 0 1 36 0v26z" fill="none" stroke="currentColor" stroke-width="1.6" />
    <!-- vòm trong (mặt lõm) -->
    <path d="M7 46V21a13 13 0 0 1 26 0v25" fill="none" stroke="currentColor" stroke-width="0.9" opacity=".45" />
    <!-- bóng đổ của chữ -->
    {!mono && <text x="20.9" y="39.9" text-anchor="middle" class="mono shadow">TS</text>}
    <!-- chữ lồng -->
    <text x="20" y="39" text-anchor="middle" class="mono">TS</text>
  </svg>
  <span class="word"><span class="a">Điêu khắc</span><span class="b">Trần Sâm</span></span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.75rem; line-height: 1; }
  .mark { width: 2.4rem; height: 2.9rem; flex: none; overflow: visible; }
  .mono { font-family: var(--font-display); font-variation-settings: 'wdth' 68; font-weight: 500; font-size: 19px; letter-spacing: -0.3px; fill: currentColor; }
  .shadow { opacity: 0.18; }
  .word { display: flex; flex-direction: column; gap: 0.2rem; }
  .a { font-size: 0.75rem; letter-spacing: 0.02em; opacity: 0.75; }
  .b { font-family: var(--font-display); font-variation-settings: 'wdth' 75; font-size: 1.5rem; font-weight: 500; letter-spacing: -0.005em; }
</style>
