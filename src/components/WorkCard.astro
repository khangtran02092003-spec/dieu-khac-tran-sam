---
import Picture from './Picture.astro';
import { categoryBySlug } from '../data/categories';
interface Props {
  work: { id: string; data: { title: string; category: string; material?: string; images: string[]; size?: string } };
  ratio?: string;
  sizes?: string;
  showCategory?: boolean;
  arch?: boolean; // khung khám vòm
}
const { work, ratio = '4 / 5', sizes = '(max-width: 720px) 100vw, 33vw', showCategory = true, arch = false } = Astro.props;
const d = work.data;
const meta = [showCategory ? categoryBySlug[d.category]?.name : null, d.material, d.size].filter(Boolean).join(', ');
---
<a class:list={['work', { arch }]} href={`/tac-pham/${d.category}/${work.id}/`}>
  <span class="frame">
    <Picture src={d.images[0]} alt={d.title} ratio={ratio} sizes={sizes} />
    <span class="sheen" aria-hidden="true"></span>
  </span>
  <span class="museum-label">
    <span class="t">{d.title}</span>
    {meta && <span class="m">{meta}</span>}
  </span>
</a>
<style>
  .work { display: block; text-decoration: none; color: inherit; }
  .frame { position: relative; display: block; overflow: hidden; }
  .arch .frame { border-radius: 999px 999px 0 0; }
  .work :global(.pic img) { transition: transform 900ms var(--ease-out); }
  .work:hover :global(.pic img) { transform: scale(1.035); }
  /* Vệt sáng xiên lướt qua một lần khi rê chuột, như đèn quét mặt phù điêu */
  .sheen {
    position: absolute; inset: -10%; pointer-events: none;
    background: linear-gradient(115deg, transparent 38%, rgba(255, 238, 210, 0.32) 50%, transparent 62%);
    transform: translateX(-110%); mix-blend-mode: soft-light;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .work:hover .sheen { transform: translateX(110%); transition: transform 1100ms var(--ease-out); }
  }
  .work:hover .t { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  .work:focus-visible { outline-offset: 6px; }
</style>
