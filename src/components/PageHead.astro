---
interface Props { title: string; lede?: string; crumbs?: { href: string; label: string }[]; small?: boolean }
const { title, lede, crumbs = [], small = false } = Astro.props;
---
<header class:list={['ph', { small }]}>
  <div class="wrap">
    {crumbs.length > 0 && (
      <nav aria-label="Đường dẫn" class="crumbs">
        <ol>
          <li><a href="/">Trang chủ</a></li>
          {crumbs.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
        </ol>
      </nav>
    )}
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</header>
<style>
  .ph { padding-block: clamp(3rem, 2rem + 5vw, 7rem) clamp(2.5rem, 2rem + 3vw, 4.5rem); }
  h1 { font-size: var(--step-5); max-width: 16ch; }
  .small h1 { font-size: var(--step-4); max-width: 22ch; }
  .lede { margin-top: 1.5rem; max-width: 52ch; }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.25rem 0.6rem; list-style: none; margin: 0 0 2rem; padding: 0; font-size: var(--step--1); color: var(--fg-soft); }
  .crumbs li + li::before { content: '/'; margin-right: 0.6rem; color: var(--rule); }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
</style>
